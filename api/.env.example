# CORS — origem do frontend em dev
CORS_ORIGINS=http://localhost:5175

# Modo mock: 1 = gera compradores fictícios a partir do próprio CSV
# (para desenvolver sem acesso ao banco). Em produção, deixar 0.
MOCK_BUYERS=0
