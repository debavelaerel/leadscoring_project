# =============================================================================
# Lead Score Vício — variáveis locais (NÃO COMMITAR o .env real)
#
# Usado pelos scripts que rodam na sua máquina:
#   npm run db:check     — diagnóstico da conexão e das permissões
#   npm run db:migrate   — aplica db/migrations/*.sql
#
# O Worker usa .dev.vars em dev e `wrangler secret put` em produção.
# =============================================================================

DATABASE_URL=postgres://USUARIO:SENHA@SEU-RDS.xxxxxxxxxxxx.sa-east-1.rds.amazonaws.com:5432/postgres?sslmode=require

# Alternativa ao DATABASE_URL (os scripts aceitam as duas formas):
# DB_HOST=SEU-RDS.xxxxxxxxxxxx.sa-east-1.rds.amazonaws.com
# DB_PORT=5432
# DB_NAME=postgres
# DB_USER=
# DB_PASSWORD=
# DB_SSLMODE=disable
